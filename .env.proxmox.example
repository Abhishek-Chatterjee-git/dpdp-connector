# =====================================================================
# DPDP COMPLIANCE PLATFORM — PROXMOX / MULTI-VM PRODUCTION ENVIRONMENT
# =====================================================================

# ---------------------------------------------------------------------
# VM 1: DPO CONTROL PLANE & AUDIT LEDGER (e.g., 192.168.1.100)
# ---------------------------------------------------------------------
CONTROL_PLANE_PORT=4000
CONTROL_PLANE_URL=http://192.168.1.100:4000
NODE_ENV=production

# ---------------------------------------------------------------------
# VM 2: ENTERPRISE STOREFRONT APP (e.g., 192.168.1.101)
# ---------------------------------------------------------------------
ECOM_PORT=3000
# Zone Agent endpoint for hot-path sub-ms consent evaluation (< 1ms)
AGENT_URL=http://192.168.1.102:5000
# Database connection (PostgreSQL on VM 3 or SQLite)
DB_CONNECTION_STRING=postgres://app_user:SecurePass@192.168.1.102:5432/enterprise_ecom

# ---------------------------------------------------------------------
# VM 3: ZONE AGENT & DATABASE NODE (e.g., 192.168.1.102)
# ---------------------------------------------------------------------
AGENT_ID=agent-proxmox-mumbai-01
AGENT_NAME=Proxmox-VPC-Zone-Agent
AGENT_PORT=5000
DB_TYPE=POSTGRES
PROBE_SUBNET=192.168.1.0/24
HEARTBEAT_INTERVAL_MS=3000
DDL_CHECK_INTERVAL_MS=5000
